{
  "name": "@ksamint/agent-sdk",
  "version": "2.5.5",
  "engines": {
    "node": ">=24.19 <25"
  },
  "packageManager": "npm@11.7.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hpke/core": "^1.9.0",
    "@ksamint/vault-protocol": "file:../VaultProtocolTS",
    "@types/node": "^24.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
