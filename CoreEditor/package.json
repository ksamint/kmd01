{
  "name": "markedit-app",
  "version": "2.5.5",
  "engines": {
    "node": ">=24.19 <25"
  },
  "description": "Just like TextEdit on Mac but dedicated to Markdown.",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "codegen": "ts-gyb --config ./src/@codegen/config.json >/dev/null",
    "test": "jest",
    "build": "yarn lint && yarn codegen && vite build && vite build -c src/@light/vite.config.mts && vite build -c src/@preview/vite.config.mts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/lang-yaml": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0",
    "@lezer/markdown": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/jest": "^29.5.4",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-compat": "^6.0.2",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "markedit-api": "https://github.com/MarkEdit-app/MarkEdit-api#v0.28.0",
    "rollup": "^4.62.4",
    "ts-gyb": "^0.12.0",
    "ts-jest": "^29.4.12",
    "tslib": "^2.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.0.1"
  },
  "resolutions": {
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.1",
    "minimatch": "^10.2.5",
    "picomatch": "^4.0.4",
    "esbuild": "^0.28.2",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "undici": "^8.9.0"
  },
  "browserslist": [
    "safari >= 18"
  ],
  "packageManager": "yarn@4.18.0"
}
