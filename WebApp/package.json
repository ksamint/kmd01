{
  "name": "ksamint-notes-web",
  "private": true,
  "version": "2.5.5",
  "engines": {
    "node": ">=24.19 <25"
  },
  "packageManager": "npm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mac": "tsc -b && vite build --config vite.mac.config.ts",
    "validate:mac-bundle": "node ../Scripts/validate-mac-web-bundle.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.8",
    "@huggingface/tokenizers": "^0.1.3",
    "@ksamint/vault-protocol": "file:../VaultProtocolTS",
    "@scure/bip39": "^2.3.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.2.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
