        "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択した PDF または文書画像は、設定済みの Tencent MinerU Precision VLM サービスへ TLS でアップロードされます。元データは送信後に削除され、結果は1時間後に期限切れになります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选 PDF 或文档图片将通过 TLS 上传到已配置的腾讯 MinerU Precision VLM 服务。源文件提交后立即删除，结果一小时后过期。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "所選 PDF 或文件圖片將透過 TLS 上傳至已設定的騰訊 MinerU Precision VLM 服務。來源檔案提交後立即刪除，結果一小時後到期。" } }
