    "No compatible resource preview module is installed.": {
      "comment": "Resource preview",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装兼容的资源预览模块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安裝相容的資源預覽模組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互換性のあるリソースプレビューモジュールがインストールされていません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun module d’aperçu de ressources compatible n’est installé."
          }
        }
      }
    },
    "The online module catalog is unavailable. Built-in previews remain available.": {
      "comment": "Resource preview",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线模块目录暂时不可用。内置预览仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線上模組目錄暫時無法使用。內建預覽仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインモジュールカタログを利用できません。内蔵プレビューは引き続き使用できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le catalogue de modules en ligne est indisponible. Les aperçus intégrés restent utilisables."
          }
        }
      }
    },
    "The preview module stopped unexpectedly. Reopen the resource to retry.": {
      "comment": "Resource preview",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览模块意外停止。请重新打开资源后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽模組意外停止。請重新開啟資源後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューモジュールが予期せず停止しました。リソースを開き直して再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le module d’aperçu s’est arrêté de manière inattendue. Rouvrez la ressource pour réessayer."
          }
        }
      }
    },
