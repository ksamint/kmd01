        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存密钥" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "儲存金鑰" } }
      }
    },
    "The key is stored only in this Mac’s Keychain and is never written to app preferences, logs, or Markdown files." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La clé est stockée uniquement dans le Trousseau de ce Mac et n’est jamais écrite dans les préférences, les journaux ou les fichiers Markdown." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キーはこの Mac のキーチェーンにのみ保存され、設定、ログ、Markdown ファイルには書き込まれません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "密钥仅保存在此 Mac 的钥匙串中，不会写入 App 偏好、日志或 Markdown 文件。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "金鑰僅儲存在此 Mac 的鑰匙圈中，不會寫入 App 偏好、日誌或 Markdown 檔案。" } }
      }
    },
    "Show history when opening a blank window" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Afficher l’historique à l’ouverture d’une fenêtre vide" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "空のウインドウを開いたときに履歴を表示" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开空白窗口时显示历史记录" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟空白視窗時顯示歷史記錄" } }
      }
    },
    "The selected Markdown will be sent over TLS to the Datamerge conversion service. DOCX files are saved next to the sources; the Markdown files are not modified." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Markdown sélectionné sera envoyé via TLS au service de conversion Datamerge. Les fichiers DOCX sont enregistrés à côté des sources ; les fichiers Markdown ne sont pas modifiés." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択した Markdown は TLS 経由で Datamerge 変換サービスへ送信されます。DOCX はソースの隣に保存され、Markdown は変更されません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选 Markdown 将通过 TLS 发送至 Datamerge 转换服务。DOCX 保存在源文件旁边，Markdown 不会被修改。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "所選 Markdown 將透過 TLS 傳送至 Datamerge 轉換服務。DOCX 會儲存在來源檔案旁，Markdown 不會被修改。" } }
      }
    },
    "Approval is required in System Settings › Login Items" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une autorisation est requise dans Réglages Système › Ouverture" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "システム設定 › ログイン項目で許可が必要です" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要在系统设置 › 登录项中批准" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要在系統設定 › 登入項目中核准" } }
      }
    },
    "Background capture is unavailable on this Mac" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La capture en arrière-plan n’est pas disponible sur ce Mac" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac ではバックグラウンド取り込みを利用できません" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 Mac 无法使用后台捕捉" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此 Mac 無法使用背景擷取" } }
      }
    },
    "Captured conversations are always saved locally immediately. This interval applies only after end-to-end encrypted cloud sync is enabled." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les conversations capturées sont toujours enregistrées immédiatement en local. Cet intervalle ne s’applique qu’après l’activation de la synchronisation cloud chiffrée de bout en bout." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "取り込んだ会話は常に直ちにローカルへ保存されます。この間隔はエンドツーエンド暗号化クラウド同期を有効にした後にのみ適用されます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "捕捉的对话始终立即保存在本地；此间隔仅在启用端到端加密云同步后生效。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "擷取的對話一律立即儲存在本機；此間隔僅在啟用端對端加密雲端同步後生效。" } }
      }
    },
    "Captured conversations are saved inside the authorized workspace’s Conversations folder." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les conversations capturées sont enregistrées dans le dossier Conversations de l’espace de travail autorisé." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "取り込んだ会話は、許可済みワークスペースの Conversations フォルダに保存されます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "捕捉的对话保存在已授权工作区的 Conversations 文件夹中。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "擷取的對話會儲存在已授權工作區的 Conversations 資料夾中。" } }
      }
    },
    "Choose a workspace first" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez d’abord un espace de travail" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "先にワークスペースを選択してください" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先选择工作区" } },
