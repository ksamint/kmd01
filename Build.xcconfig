//
//  Build.xcconfig
//  MarkEditMac
//
//  Created by cyan on 12/26/22.
//
//  https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

ENTITLEMENTS_VARIANT =
MARKEDITMAC_ENTITLEMENTS = MarkEditMac/Info$(ENTITLEMENTS_VARIANT).entitlements
PREVIEWEXTENSION_ENTITLEMENTS = PreviewExtension/Info$(ENTITLEMENTS_VARIANT).entitlements

CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = art.apuch.ksamint.markedit$(BUNDLE_ID_SUFFIX)
BUNDLE_ID_SUFFIX = .dev
BUNDLE_ID_SUFFIX[config=Release] =
REGISTER_APP_GROUPS = YES

MARKETING_VERSION = 2.5.5
CURRENT_PROJECT_VERSION = 18
SWIFT_VERSION = 6.0
ARCHS = arm64
VALID_ARCHS = arm64

// Keep the ARM64 release below the 6 MiB distribution budget without
// affecting Debug diagnostics.
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -Osize
COPY_PHASE_STRIP[config=Release] = YES
STRIP_INSTALLED_PRODUCT[config=Release] = YES
STRIP_STYLE[config=Release] = non-global
STRIP_SWIFT_SYMBOLS[config=Release] = YES
// Do not enable deployment postprocessing globally: Xcode applies it to
// Swift package intermediate relocatable objects, where stripping referenced
// symbols corrupts the object and causes archive failures.
DEPLOYMENT_POSTPROCESSING[config=Release] = NO
SWIFT_REFLECTION_METADATA_LEVEL[config=Release] = none
ASSETCATALOG_COMPILER_OPTIMIZATION[config=Release] = space

#include? "Local.xcconfig"
